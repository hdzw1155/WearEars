<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<com.hdz.wearcontrol.AppScrollView android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_ui_style"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/style_new"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_new"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/style_classic"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_classic"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/style_liquid"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_liquid"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_tile_style"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tile_new"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_new"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tile_liquid"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_liquid"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tile_classic"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_style_classic"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tile_follow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_choice"
                android:gravity="center"
                android:text="@string/settings_style_follow"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_scroll_color"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/scroll_color_dynamic"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_scroll_color_dynamic"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/scroll_color_classic"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_scroll_color_classic"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_language"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lang_zh"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_lang_zh"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lang_en"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_choice"
                    android:gravity="center"
                    android:text="@string/settings_lang_en"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/lang_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_choice"
                android:gravity="center"
                android:text="@string/settings_lang_system"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/device_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_choice"
                android:gravity="center"
                android:text="@string/settings_device_auto"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/volume_title"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/volume_choice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:layout_marginTop="8dp"
                android:padding="6dp"
                android:background="@drawable/bg_choice"
                android:gravity="center"
                android:text="@string/settings_volume_show"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/settings_hint"
            android:textColor="@color/text_faint"
            android:textSize="10sp" />
    </LinearLayout>
</com.hdz.wearcontrol.AppScrollView>

    <com.hdz.wearcontrol.ArcIndicatorView
        android:id="@+id/settings_indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
