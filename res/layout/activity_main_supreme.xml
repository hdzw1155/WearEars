<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F3EE">

    <!-- Full-screen curved C-arc + alternating folding-fan deck (ZERO internal scrolling) -->
    <com.hdz.wearcontrol.SuprematistFanDeckView
        android:id="@+id/fan_deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Sheet 0: All-in-One El Lissitzky Hero Poster (WearEars + ANC + L/R/C + Guarded Volume) -->
        <FrameLayout
            android:id="@+id/sup_page_power"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="paper" />

            <com.hdz.wearcontrol.SuprematistDialView
                android:id="@+id/sup_dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Sheet 1: Reference #2 Constructivist Control Poster ("02 / 控制") -->
        <FrameLayout
            android:id="@+id/sup_page_control"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="control" />

            <com.hdz.wearcontrol.SuprematistControlView
                android:id="@+id/sup_control"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Sheet 2: Dedicated Dev Lab Sheet (Enabled on 5-tap unlock, Circular-Safe, Zero Scroll) -->
        <FrameLayout
            android:id="@+id/sup_page_dev"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="hazard" />

            <LinearLayout
                android:id="@+id/dev_section"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="42dp"
                android:paddingTop="32dp"
                android:paddingRight="36dp"
                android:paddingBottom="32dp"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="#DF1B22" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/sup_sec_dev"
                        android:textColor="@color/sup_ink"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Spatial Audio Card (parentOf depth = 2 from switch_spatial) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_sup_card_paper"
                    android:orientation="vertical"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/spatial_title_short"
                            android:textColor="@color/sup_ink"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <Switch
                            android:id="@+id/switch_spatial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="26dp"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/spatial_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/spatial_hint_inline"
                        android:textColor="#DF1B22"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- DeepX Card (parentOf depth = 2 from deepx_current), compact 2-row grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_sup_card_paper"
                    android:orientation="vertical"
                    android:paddingLeft="7dp"
                    android:paddingTop="4dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/deepx_label"
                            android:textColor="@color/sup_ink"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/deepx_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="#0D4FB8"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/deepx_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/deepx_0"
                                android:layout_width="0dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sup_chip"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/deepx_std"
                                android:textColor="@color/sup_ink"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/deepx_1"
                                android:layout_width="0dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sup_chip"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/deepx_vocal"
                                android:textColor="@color/sup_ink"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/deepx_2"
                                android:layout_width="0dp"
                                android:layout_height="22dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sup_chip"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/deepx_bass"
                                android:textColor="@color/sup_ink"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/deepx_3"
                                android:layout_width="0dp"
                                android:layout_height="22dp"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sup_chip"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/deepx_treble"
                                android:textColor="@color/sup_ink"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/deepx_4"
                                android:layout_width="0dp"
                                android:layout_height="22dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_sup_chip"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/deepx_book"
                                android:textColor="@color/sup_ink"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Sheet 3: Poster Manifesto Notice (Circular-Safe Inset, Zero Scroll) -->
        <FrameLayout
            android:id="@+id/sup_page_notice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="manifesto" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="28dp"
                android:paddingTop="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="#0D4FB8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/sup_sec_notice"
                        android:textColor="@color/sup_ink"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/disclaimer_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_sup_card_paper"
                    android:orientation="vertical"
                    android:paddingLeft="8dp"
                    android:paddingTop="5dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="0.5dp"
                        android:text="@string/sup_notice_summary"
                        android:textColor="@color/sup_ink"
                        android:textSize="9sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sup_full_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_sup_cta_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="@string/sup_full_notice"
                    android:textColor="@color/sup_paper"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </com.hdz.wearcontrol.SuprematistFanDeckView>

    <!-- Left-bezel C-arc orbital page indicator ("第一屏 <- -> 最后一屏") -->
    <com.hdz.wearcontrol.SuprematistPageRailView
        android:id="@+id/page_rail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
