<?xml version="1.0" encoding="utf-8"?>
<!-- 至上 (Suprematism) screen: alternating folding-fan deck + 4 distinct geometric sheets -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sup_paper">

    <com.hdz.wearcontrol.SuprematistFanDeckView
        android:id="@+id/fan_deck"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Sheet 0: Warm Paper (Status & Battery) -->
        <FrameLayout
            android:id="@+id/sup_page_power"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="paper" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/page_pad"
                    android:paddingTop="20dp"
                    android:paddingRight="@dimen/page_pad"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/battery_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="5dp"
                            android:background="@color/sup_red" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.06"
                            android:text="@string/sup_sec_power"
                            android:textColor="@color/sup_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/refresh"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_sup_icon_btn"
                            android:contentDescription="@string/btn_refresh"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:padding="6dp"
                            android:src="@drawable/ic_refresh"
                            android:tint="@color/sup_ink" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:minHeight="20dp"
                        android:orientation="horizontal">

                        <com.hdz.wearcontrol.StatusDotView
                            android:id="@+id/status_dot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/status_idle"
                            android:textColor="@color/sup_ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/status_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_sup_chip"
                            android:paddingLeft="5dp"
                            android:paddingTop="1dp"
                            android:paddingRight="5dp"
                            android:paddingBottom="1dp"
                            android:textColor="@color/sup_red"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="13dp"
                        android:textColor="@color/sup_ink_dim"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/cta_reconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_sup_cta_blue"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingTop="5dp"
                        android:paddingRight="14dp"
                        android:paddingBottom="5dp"
                        android:text="@string/cta_reconnect"
                        android:textColor="@color/sup_paper_card"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Left & Right sharp Constructivist cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/card_l"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sup_card_paper"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/lbl_l"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_left"
                                android:textColor="@color/sup_ink_dim"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/row_l"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/pct_l"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/sup_ink"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/bolt_l"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_marginStart="3dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_bolt"
                                    android:tint="@color/sup_amber"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <com.hdz.wearcontrol.BatteryBarView
                                android:id="@+id/bar_l"
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/card_r"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_sup_card_paper"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/lbl_r"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="@string/label_right"
                                android:textColor="@color/sup_ink_dim"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/row_r"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/pct_r"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/sup_ink"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/bolt_r"
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:layout_marginStart="3dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_bolt"
                                    android:tint="@color/sup_amber"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <com.hdz.wearcontrol.BatteryBarView
                                android:id="@+id/bar_r"
                                android:layout_width="match_parent"
                                android:layout_height="5dp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Charging case card -->
                    <LinearLayout
                        android:id="@+id/card_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_sup_card_paper"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:id="@+id/row_c"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lbl_c"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_case"
                                android:textColor="@color/sup_ink_dim"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/pct_c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/sup_ink"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/bolt_c"
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:layout_marginStart="3dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bolt"
                                android:tint="@color/sup_amber"
                                android:visibility="gone" />
                        </LinearLayout>

                        <com.hdz.wearcontrol.BatteryBarView
                            android:id="@+id/bar_c"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:letterSpacing="0.08"
                        android:text="@string/sup_swipe_hint"
                        android:textColor="@color/sup_ink_faint"
                        android:textSize="9sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Sheet 1: Obsidian Ink (Acoustic: ANC & Volume) -->
        <FrameLayout
            android:id="@+id/sup_page_acoustic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="ink">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="ink" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/page_pad"
                    android:paddingTop="24dp"
                    android:paddingRight="@dimen/page_pad"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@color/sup_yellow" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/sup_sec_acoustic"
                            android:textColor="@color/sup_paper"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ANC Control (parentOf depth = 1 -> this container) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_sup_card_dark"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/noise_title"
                            android:textColor="@color/sup_ink_faint"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <com.hdz.wearcontrol.NoiseSegmentedView
                            android:id="@+id/noise_seg"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Volume Fader -->
                    <LinearLayout
                        android:id="@+id/volume_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_sup_card_dark"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/volume_title"
                                android:textColor="@color/sup_paper"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/volume_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:textColor="@color/sup_yellow"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.hdz.wearcontrol.VolumeBarView
                            android:id="@+id/volume_bar"
                            android:layout_width="match_parent"
                            android:layout_height="26dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Sheet 2: Warm Paper (Settings & Developer Options) -->
        <FrameLayout
            android:id="@+id/sup_page_control"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="paper">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="paper" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/page_pad"
                    android:paddingTop="24dp"
                    android:paddingRight="@dimen/page_pad"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@color/sup_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/sup_sec_control"
                            android:textColor="@color/sup_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/open_settings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_sup_btn_paper"
                        android:gravity="center"
                        android:padding="11dp"
                        android:text="@string/sup_open_settings"
                        android:textColor="@color/sup_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dev_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/dev_section"
                        android:textColor="@color/sup_ink_dim"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/dev_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Spatial card: preserve switch_spatial parentOf depth = 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_sup_card_paper"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/spatial_switch"
                                    android:textColor="@color/sup_ink"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Switch
                                    android:id="@+id/switch_spatial"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:showText="false"
                                    android:thumbTint="@color/sup_blue"
                                    android:trackTint="@color/sup_track_light" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/spatial_hint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/spatial_hint_inline"
                                android:textColor="@color/sup_red"
                                android:textSize="10sp"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/spatial_caption_lines"
                                android:textColor="@color/sup_ink_dim"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- DeepX card: preserve deepx_current parentOf depth = 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_sup_card_paper"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/deepx_label"
                                    android:textColor="@color/sup_ink_dim"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/deepx_current"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/sup_blue"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.hdz.wearcontrol.SnapChipRow
                                android:id="@+id/deepx_scroller"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp">

                                <LinearLayout
                                    android:id="@+id/deepx_row"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/deepx_0"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:background="@drawable/bg_sup_chip"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:minHeight="36dp"
                                        android:paddingLeft="10dp"
                                        android:paddingTop="7dp"
                                        android:paddingRight="10dp"
                                        android:paddingBottom="7dp"
                                        android:text="@string/deepx_std"
                                        android:textColor="@color/sup_ink_dim"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/deepx_1"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:background="@drawable/bg_sup_chip"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:minHeight="36dp"
                                        android:paddingLeft="10dp"
                                        android:paddingTop="7dp"
                                        android:paddingRight="10dp"
                                        android:paddingBottom="7dp"
                                        android:text="@string/deepx_vocal"
                                        android:textColor="@color/sup_ink_dim"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/deepx_2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:background="@drawable/bg_sup_chip"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:minHeight="36dp"
                                        android:paddingLeft="10dp"
                                        android:paddingTop="7dp"
                                        android:paddingRight="10dp"
                                        android:paddingBottom="7dp"
                                        android:text="@string/deepx_bass"
                                        android:textColor="@color/sup_ink_dim"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/deepx_3"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:background="@drawable/bg_sup_chip"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:minHeight="36dp"
                                        android:paddingLeft="10dp"
                                        android:paddingTop="7dp"
                                        android:paddingRight="10dp"
                                        android:paddingBottom="7dp"
                                        android:text="@string/deepx_treble"
                                        android:textColor="@color/sup_ink_dim"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/deepx_4"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_sup_chip"
                                        android:gravity="center"
                                        android:minWidth="52dp"
                                        android:minHeight="36dp"
                                        android:paddingLeft="10dp"
                                        android:paddingTop="7dp"
                                        android:paddingRight="10dp"
                                        android:paddingBottom="7dp"
                                        android:text="@string/deepx_book"
                                        android:textColor="@color/sup_ink_dim"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.hdz.wearcontrol.SnapChipRow>
                        </LinearLayout>

                        <!-- Volume bar toggle card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_sup_card_paper"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/volume_title"
                                    android:textColor="@color/sup_ink"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <Switch
                                    android:id="@+id/switch_volume"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:showText="false"
                                    android:thumbTint="@color/sup_blue"
                                    android:trackTint="@color/sup_track_light" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/volume_switch_hint"
                                android:textColor="@color/sup_ink_dim"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Sheet 3: Deep Ultramarine (Safety Disclaimer) -->
        <FrameLayout
            android:id="@+id/sup_page_notice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="blue">

            <com.hdz.wearcontrol.SuprematistDecorView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="blue" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/page_pad"
                    android:paddingTop="26dp"
                    android:paddingRight="@dimen/page_pad"
                    android:paddingBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="6dp"
                            android:background="@color/sup_yellow" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.06"
                            android:text="@string/sup_sec_notice"
                            android:textColor="@color/sup_paper"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/disclaimer_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_sup_card_blue"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/disclaimer_heading_official"
                            android:textColor="@color/sup_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/disclaimer_body_official"
                            android:textColor="@color/sup_paper"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/disclaimer_heading_safety"
                            android:textColor="@color/sup_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/disclaimer_body_safety"
                            android:textColor="@color/sup_paper"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/disclaimer_heading_risk"
                            android:textColor="@color/sup_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/disclaimer_body_risk"
                            android:textColor="@color/sup_paper"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </com.hdz.wearcontrol.SuprematistFanDeckView>

    <!-- Fixed rotated-diamond page rail along right circular bezel -->
    <com.hdz.wearcontrol.SuprematistPageRailView
        android:id="@+id/page_rail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
