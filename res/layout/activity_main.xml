<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: status header / battery cards / noise segmented / dev section / disclaimer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- content layer: native drag scrolling; rotary crown handled by AppScrollView -->
    <com.hdz.wearcontrol.AppScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/page_pad"
            android:paddingTop="28dp"
            android:paddingRight="@dimen/page_pad"
            android:paddingBottom="18dp">

            <!-- status header: dot + main line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="24dp"
                android:orientation="horizontal">

                <com.hdz.wearcontrol.StatusDotView
                    android:id="@+id/status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="7dp" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/status_idle"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_warn"
                    android:paddingLeft="7dp"
                    android:paddingTop="2dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/warn"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="14dp"
                android:textColor="@color/text_dim"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/cta_reconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cta"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingTop="7dp"
                android:paddingRight="16dp"
                android:paddingBottom="7dp"
                android:text="@string/cta_reconnect"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- battery section header: caption + refresh icon button -->
            <LinearLayout
                android:id="@+id/battery_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/battery_title"
                    android:textColor="@color/text_faint"
                    android:textSize="@dimen/text_caption" />

                <ImageView
                    android:id="@+id/refresh"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="@string/btn_refresh"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:padding="8dp"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/text_dim" />
            </LinearLayout>

            <!-- battery: left / right cards side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_2"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card_l"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lbl_l"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_left"
                        android:textColor="@color/text_faint"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:id="@+id/row_l"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pct_l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text"
                            android:textSize="@dimen/text_number"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/bolt_l"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bolt"
                            android:tint="@color/warn"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.hdz.wearcontrol.BatteryBarView
                        android:id="@+id/bar_l"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/bar_height"
                        android:layout_marginTop="@dimen/gap_2" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_r"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_2"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lbl_r"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/label_right"
                        android:textColor="@color/text_faint"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="end|center_vertical"
                        android:id="@+id/row_r"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pct_r"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/text"
                            android:textSize="@dimen/text_number"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/bolt_r"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bolt"
                            android:tint="@color/warn"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.hdz.wearcontrol.BatteryBarView
                        android:id="@+id/bar_r"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/bar_height"
                        android:layout_marginTop="@dimen/gap_2" />
                </LinearLayout>
            </LinearLayout>

            <!-- battery: case card (full width) -->
            <LinearLayout
                    android:id="@+id/card_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_2"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                        android:id="@+id/row_c"

                    <TextView
                        android:id="@+id/lbl_c"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_case"
                        android:textColor="@color/text_faint"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/pct_c"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/text"
                        android:textSize="@dimen/text_number"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/bolt_c"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bolt"
                        android:tint="@color/warn"
                        android:visibility="gone" />
                </LinearLayout>

                <com.hdz.wearcontrol.BatteryBarView
                    android:id="@+id/bar_c"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/bar_height"
                    android:layout_marginTop="@dimen/gap_2" />
            </LinearLayout>

            <!-- 经典电量: 一张大卡, 顶部 电量+刷新, 下面三块一行 -->
            <LinearLayout
                android:id="@+id/battery_classic_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_2"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_title"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_body" />

                    <ImageView
                        android:id="@+id/refresh_card"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/btn_refresh"
                        android:padding="7dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ring_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryRectRingView
                            android:id="@+id/ring_l"
                            android:layout_width="match_parent"
                            android:layout_height="34dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_left"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryRectRingView
                            android:id="@+id/ring_r"
                            android:layout_width="match_parent"
                            android:layout_height="34dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_right"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryRectRingView
                            android:id="@+id/ring_c"
                            android:layout_width="match_parent"
                            android:layout_height="34dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_case"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/block_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryBlockView
                            android:id="@+id/block_l"
                            android:layout_width="match_parent"
                            android:layout_height="88dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_left"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryBlockView
                            android:id="@+id/block_r"
                            android:layout_width="match_parent"
                            android:layout_height="88dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_right"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <com.hdz.wearcontrol.BatteryBlockView
                            android:id="@+id/block_c"
                            android:layout_width="match_parent"
                            android:layout_height="88dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_case"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- noise control card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_3"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/noise_title"
                    android:textColor="@color/text_faint"
                    android:textSize="@dimen/text_caption" />

                <com.hdz.wearcontrol.NoiseSegmentedView
                    android:id="@+id/noise_seg"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/gap_2" />
            </LinearLayout>

            <!-- dev entry: tap 5 times to unlock -->
            <TextView
                android:id="@+id/dev_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_4"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/dev_section"
                android:textColor="@color/text_faint"
                android:textSize="@dimen/text_caption" />

            <!-- dev section -->
            <LinearLayout
                android:id="@+id/dev_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_1"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/spatial_switch"
                            android:textColor="@color/text"
                            android:textSize="@dimen/text_body" />

                        <Switch
                            android:id="@+id/switch_spatial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:showText="false"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/spatial_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_1"
                        android:text="@string/spatial_hint_inline"
                        android:textColor="@color/warn"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_2"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/spatial_caption_lines"
                        android:textColor="@color/text_dim"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_3"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/deepx_label"
                            android:textColor="@color/text_faint"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/deepx_current"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <com.hdz.wearcontrol.SnapChipRow
                        android:id="@+id/deepx_scroller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap_2">

                        <LinearLayout
                            android:id="@+id/deepx_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/deepx_0"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:minWidth="56dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:text="@string/deepx_std"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepx_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:minWidth="56dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:text="@string/deepx_vocal"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepx_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:minWidth="56dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:text="@string/deepx_bass"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepx_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:minWidth="56dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:text="@string/deepx_treble"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/deepx_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_chip"
                                android:gravity="center"
                                android:minWidth="56dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"
                                android:text="@string/deepx_book"
                                android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.hdz.wearcontrol.SnapChipRow>
                </LinearLayout>
            </LinearLayout>

            <!-- disclaimer: full text on page bottom, three short sections -->
            <LinearLayout
                android:id="@+id/disclaimer_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_3"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/disclaimer_heading_official"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/disclaimer_body_official"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_3"
                    android:text="@string/disclaimer_heading_safety"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/disclaimer_body_safety"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_3"
                    android:text="@string/disclaimer_heading_risk"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_1"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/disclaimer_body_risk"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- bottom breathing room so the last card can scroll to the middle -->
            <TextView
                android:id="@+id/open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/cta_settings"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>
    </com.hdz.wearcontrol.AppScrollView>

    <!-- fixed scroll indicator: pinned to the right edge of the round screen -->
    <com.hdz.wearcontrol.ArcIndicatorView
        android:id="@+id/indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
