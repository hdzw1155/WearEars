<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dev_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.hdz.wearcontrol.AppScrollView
        android:id="@+id/dev_settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fadeScrollbars="true"
        android:fillViewport="true"
        android:scrollbarStyle="insideOverlay"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/dev_settings_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/dev_settings_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="@string/dev_settings_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 多端本地协同（局域网） -->
            <LinearLayout
                android:id="@+id/mesh_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_set_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_mesh_title"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mesh_mode_off"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_set_choice"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/settings_mesh_off"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/mesh_mode_host"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_set_choice"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/settings_mesh_host"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/mesh_mode_client"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_set_choice"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/settings_mesh_client"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mesh_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mesh_action_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:padding="6dp"
                    android:text="@string/settings_mesh_pick_host"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 应用层内网防火墙 -->
            <LinearLayout
                android:id="@+id/firewall_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_set_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/fw_card_title"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/fw_toggle_enabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/fw_enabled_on"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fw_toggle_same_subnet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/fw_same_subnet_on"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fw_toggle_allowlist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/fw_allowlist_only_off"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fw_toggle_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/fw_readonly_off"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fw_allowlist_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp"
                    android:text="@string/fw_manage_allowlist"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fw_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/fw_logs_btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_set_choice"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp"
                        android:text="@string/fw_view_logs"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/fw_clear_bans_btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_set_choice"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:paddingStart="4dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="6dp"
                        android:text="@string/fw_clear_bans"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 本机应用联动 -->
            <LinearLayout
                android:id="@+id/intent_bridge_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_set_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/settings_intent_bridge"
                    android:textColor="@color/text_faint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/intent_bridge_choice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_set_choice"
                    android:gravity="center"
                    android:minHeight="34dp"
                    android:padding="6dp"
                    android:text="@string/settings_intent_bridge_off"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dev_settings_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/settings_hint"
                android:textColor="@color/text_faint"
                android:textSize="10sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </com.hdz.wearcontrol.AppScrollView>

    <com.hdz.wearcontrol.ArcIndicatorView
        android:id="@+id/dev_settings_indicator"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
