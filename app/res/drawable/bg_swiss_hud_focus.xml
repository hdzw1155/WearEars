<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#002FA7" />
            <stroke android:width="2dp" android:color="#A8CAFF" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#002FA7" />
            <stroke android:width="2dp" android:color="#3B82F6" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0A1633" />
            <stroke android:width="2dp" android:color="#3B82F6" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#002FA7" />
            <stroke android:width="1dp" android:color="#3B82F6" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0C0E14" />
            <stroke android:width="1dp" android:color="#262B36" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>
