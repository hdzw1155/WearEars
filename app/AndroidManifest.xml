<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hdz.wearcontrol">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- 旋转表圈/表冠的短脉冲震感直接走 Vibrator, 需要这条普通权限 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 本机单端空间音频 DSP (AudioEffect / DynamicsProcessing) 所需普通权限 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 纯局域网多端本地协同所需权限（仅限私有局域网，不联网） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-feature android:name="android.hardware.type.watch" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".DeveloperSettingsActivity"
            android:exported="false"
            android:label="@string/dev_settings_title" />

        <activity
            android:name=".SpatialLabActivity"
            android:exported="false"
            android:label="@string/spatial_lab_title" />

        <receiver android:name=".TileConnectionReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.headset.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.bluetooth.action.LE_AUDIO_CONNECTION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 同机本地软件联动接收器（默认关闭，内部受免责与设置开关双重门控） -->
        <receiver android:name=".LocalControlReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.hdz.wearcontrol.ACTION_SET_NOISE" />
                <action android:name="com.hdz.wearcontrol.ACTION_CYCLE_NOISE" />
                <action android:name="com.hdz.wearcontrol.ACTION_REFRESH" />
            </intent-filter>
        </receiver>

        <!-- 磁贴: 系统磁贴宿主通过这条导出服务绑定; 预览图是磁贴列表里显示的那张 -->
        <service
            android:name=".TwsTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_preview"
            android:label="@string/tile_title"
            android:description="@string/tile_desc"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_tile_preview" />
        </service>

        <service
            android:name=".QuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_anc"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 旧磁贴缓存迁移入口：只打开现有控制页，忽略外部控制参数。 -->
        <activity
            android:name=".ModeCyclerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>
</manifest>
